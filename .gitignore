# Windows
Thumbs.db
Desktop.ini

# PyCharm
.idea/

# Python-specific
pylint-report.txt

# Pytest cache
.pytest_cache/

# Sphinx build output. The documentation is built by a job and published as a site; the build
# itself never belongs in git.
docs/site/_build/

# Left behind by tooling that is not this project's. Ignored so a checkout stays clean.
uv.lock

# Records the reviewed release tip. Written by one release script and read by the other;
# it is state between two commands, never something to commit.
.release-state.json

# Local agent output: the orchestrator's run logs per task, and scratch notes. A build's
# handoff and briefs under .claude/log/ stay trackable; only the runs/ directories are machine
# output.
.claude/log/*/runs/
.scratch/
